# Ignore Gradle project-specific cache directory
.gradle
**/.gradle/

# Ignore Gradle build output directory
build

# Ignore Kotlin plugin data
.kotlin

# Ignore npm dependencies (node_modules everywhere, but keep package-lock.json in subprojects)
node_modules/

# Ignore IDE files
.idea/

# Ignore CodeSeeker index
.codeseeker/

# Ignore local scratch directory
tmp/

# Ignore generated DaisyUI components (built from git submodule at compile time)
lib/src/main/kotlin/io/github/ollin/kdaisyui/components/
lib/src/test/kotlin/io/github/ollin/kdaisyui/components/

# Ignore generated Heroicons icon files (built from git submodule at compile time)
# Keep hand-written enums: HeroIconVariant.kt and HeroIconSize.kt
lib/src/main/kotlin/io/github/ollin/kdaisyui/icons/*
!lib/src/main/kotlin/io/github/ollin/kdaisyui/icons/HeroIconVariant.kt
!lib/src/main/kotlin/io/github/ollin/kdaisyui/icons/HeroIconSize.kt
**/.classpath
**/.project
