{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    // used in this project
    "chrome-devtools": {
      "enabled": true
    },
    "codescene": {
      "enabled": true
    },
    "dacli": {
      "enabled": true
    },
    "daisyui-blueprint": {
      "enabled": true
    },
    "git": {
      "enabled": true
    },
    "github": {
      "enabled": true
    },
    "gradle": {
      "enabled": true
    },
    "jetbrains": {
      "enabled": true
    },
    "playwright": {
      "enabled": true
    },

    // offered - set one to true to switch it on
    "archi": {
      "enabled": false
    },
    "booksearch": {
      "enabled": false
    },
    "chrome-attach": {
      "enabled": false
    },
    "gitlab-katta": {
      "enabled": false
    },
    "gitlab-nimbus": {
      "enabled": false
    },
    "graphify": {
      "enabled": false
    },
    "pdf-mcp": {
      "enabled": false
    },
    "structurizr-mcp": {
      "enabled": false
    },
    "unifi": {
      "enabled": false
    }
  },
  "tools": {
    "bash": true,
    "interactive_bash": true,
    "write": true,
    "edit": true,
    "patch": true,
    "jetbrains_execute_terminal_command": true
  }
}
