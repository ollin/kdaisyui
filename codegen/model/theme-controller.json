{
  "component": "theme-controller",
  "name": "ThemeController",
  "class": "theme-controller",
  "enums": [],
  "functions": [
    {
      "kind": "main",
      "name": "daisyThemeController",
      "receiver": "FlowContent",
      "element": "INPUT",
      "class": "theme-controller",
      "text": false,
      "parameters": [
        {
          "kind": "extra",
          "name": "theme",
          "type": "DaisyTheme?",
          "default": "null",
          "apply": "if (theme != null) this.value = theme.value",
          "sample": "DaisyTheme.Dark",
          "imports": ["io.github.ollin.kdaisyui.themes.DaisyTheme"]
        }
      ],
      "joinItem": true
    }
  ],
  "summary": { "summary": "DaisyUI theme controller toggle" }
}
