{
  "component": "collapse",
  "name": "Collapse",
  "class": "collapse",
  "enums": [{ "name": "CollapseIcon", "label": "Icon variants", "classes": ["collapse-arrow", "collapse-plus"] }],
  "functions": [
    {
      "kind": "main",
      "name": "daisyCollapse",
      "receiver": "FlowContent",
      "element": "DIV",
      "class": "collapse",
      "text": false,
      "parameters": [
        { "kind": "enum", "name": "icon", "enum": "CollapseIcon", "doc": "Icon variant" },
        { "kind": "toggle", "name": "close", "class": "collapse-close" },
        { "kind": "toggle", "name": "open", "class": "collapse-open" }
      ],
      "joinItem": true
    },
    {
      "kind": "part",
      "name": "daisyCollapseTitle",
      "receiver": "FlowContent",
      "element": "DIV",
      "class": "collapse-title",
      "text": true,
      "parameters": []
    },
    {
      "kind": "part",
      "name": "daisyCollapseContent",
      "receiver": "FlowContent",
      "element": "DIV",
      "class": "collapse-content",
      "text": false,
      "parameters": []
    }
  ],
  "summary": { "summary": "Collapsible content sections" }
}
