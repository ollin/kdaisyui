{
  "elementCrossCheckExceptions": {
    "tab": {
      "reason": "Container and item are inverted, not merely the wrong element: daisyTab emits <button class=\"tabs\"> and daisyTabTab emits <div class=\"tab\">. Fixing it means swapping the component/part classification, which renames every function in the file.",
      "issue": 342
    },
    "calendar": {
      "reason": "DaisyUI documents Cally's custom element <calendar-date>, and kotlinx.html has no tag class for a custom element. Needs a decision — a generic custom-tag escape hatch, or skipping the component — rather than an element swap.",
      "issue": 343
    }
  },
  "skip": ["accordion", "pagination"],
  "textParams": ["button", "badge", "link", "kbd", "label", "card-title", "stat-value", "stat-desc"],
  "roles": {
    "alert": "alert",
    "status": "status"
  },
  "inputTypes": {
    "checkbox": "checkBox",
    "radio": "radio",
    "toggle": "checkBox",
    "range": "range"
  },
  "extras": {
    "button": [
      {
        "name": "disabled",
        "type": "Boolean",
        "default": "false",
        "apply": "if (disabled) { this.disabled = true; addClassNames(\"btn-disabled\") }"
      },
      {
        "name": "type",
        "type": "ButtonType?",
        "default": "null",
        "apply": "if (type != null) this.type = type",
        "imports": ["kotlinx.html.ButtonType"]
      }
    ],
    "range": [
      {
        "name": "min",
        "type": "String?",
        "default": "null",
        "apply": "if (min != null) this.min = min"
      },
      {
        "name": "max",
        "type": "String?",
        "default": "null",
        "apply": "if (max != null) this.max = max"
      },
      {
        "name": "value",
        "type": "String?",
        "default": "null",
        "apply": "if (value != null) this.value = value"
      },
      {
        "name": "step",
        "type": "String?",
        "default": "null",
        "apply": "if (step != null) this.step = step"
      },
      {
        "name": "disabled",
        "type": "Boolean",
        "default": "false",
        "apply": "if (disabled) this.disabled = true"
      }
    ],
    "toggle": [
      {
        "name": "checked",
        "type": "Boolean",
        "default": "false",
        "apply": "if (checked) this.checked = true"
      },
      {
        "name": "disabled",
        "type": "Boolean",
        "default": "false",
        "apply": "if (disabled) this.disabled = true"
      }
    ],
    "checkbox": [
      {
        "name": "checked",
        "type": "Boolean",
        "default": "false",
        "apply": "if (checked) this.checked = true"
      },
      {
        "name": "disabled",
        "type": "Boolean",
        "default": "false",
        "apply": "if (disabled) this.disabled = true"
      }
    ],
    "radio": [
      {
        "name": "name",
        "type": "String?",
        "default": "null",
        "apply": "if (name != null) this.name = name"
      },
      {
        "name": "checked",
        "type": "Boolean",
        "default": "false",
        "apply": "if (checked) this.checked = true"
      },
      {
        "name": "disabled",
        "type": "Boolean",
        "default": "false",
        "apply": "if (disabled) this.disabled = true"
      }
    ],
    "input": [
      {
        "name": "type",
        "type": "InputType",
        "default": "InputType.text",
        "apply": "this.type = type",
        "imports": ["kotlinx.html.InputType"],
        "position": "before_classes"
      },
      {
        "name": "placeholder",
        "type": "String?",
        "default": "null",
        "apply": "if (placeholder != null) this.placeholder = placeholder"
      },
      {
        "name": "value",
        "type": "String?",
        "default": "null",
        "apply": "if (value != null) this.value = value"
      },
      {
        "name": "disabled",
        "type": "Boolean",
        "default": "false",
        "apply": "if (disabled) this.disabled = true"
      }
    ],
    "select": [
      {
        "name": "disabled",
        "type": "Boolean",
        "default": "false",
        "apply": "if (disabled) this.disabled = true"
      }
    ],
    "dropdown": [
      {
        "name": "end",
        "type": "Boolean",
        "default": "false",
        "apply": "if (end) addClassNames(\"dropdown-end\")"
      },
      {
        "name": "start",
        "type": "Boolean",
        "default": "false",
        "apply": "if (start) addClassNames(\"dropdown-start\")"
      },
      {
        "name": "top",
        "type": "Boolean",
        "default": "false",
        "apply": "if (top) addClassNames(\"dropdown-top\")"
      },
      {
        "name": "bottom",
        "type": "Boolean",
        "default": "false",
        "apply": "if (bottom) addClassNames(\"dropdown-bottom\")"
      },
      {
        "name": "left",
        "type": "Boolean",
        "default": "false",
        "apply": "if (left) addClassNames(\"dropdown-left\")"
      },
      {
        "name": "right",
        "type": "Boolean",
        "default": "false",
        "apply": "if (right) addClassNames(\"dropdown-right\")"
      },
      {
        "name": "center",
        "type": "Boolean",
        "default": "false",
        "apply": "if (center) addClassNames(\"dropdown-center\")"
      }
    ]
  },
  "additionalBooleans": {
    "join": ["vertical"]
  },
  "componentElements": {
    "dropdown": "details",
    "otp": "label"
  },
  "subComponentElements": {
    "card-title": "H2",
    "card-actions": "DIV",
    "megamenu-active": "SPAN"
  },
  "componentAttributes": {
    "megamenu": { "popover": "" }
  },
  "customParts": {
    "breadcrumbs": [
      { "name": "Items", "element": "UL", "cssClass": null },
      { "name": "Item", "element": "LI", "cssClass": null, "receiver": "UL" }
    ],
    "modal": [
