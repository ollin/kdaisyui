{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": true,
  "labels": ["dependencies"],
  "assignees": ["ollin"],
  "reviewers": ["ollin"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "schedule": ["at any time"],
  "timezone": "Europe/Berlin",
  "dryRun": null,
  "semanticCommits": "enabled",
  "commitMessagePrefix": "chore(deps):",

  "packageRules": [
    {
      "description": "Group all Ktor updates into one PR",
      "groupName": "Ktor",
      "groupSlug": "ktor",
      "matchPackageNames": [
        "io.ktor{/,}**"
      ]
    },
    {
      "description": "Group all webjars updates into one PR",
      "groupName": "webjars",
      "groupSlug": "webjars",
      "matchPackageNames": [
        "org.webjars{/,}**"
      ]
    },
    {
      "description": "Group all Kotlin-related updates into one PR",
      "matchPackageNames": [
        "org.jetbrains.kotlin.jvm",
        "org.jetbrains.kotlinx:kotlinx-html-jvm"
      ],
      "groupName": "Kotlin",
      "groupSlug": "kotlin"
    },
    {
      "description": "Automerge patch updates for Playwright",
      "matchPackageNames": ["@playwright/test"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Pin GitHub Actions to digest for security",
      "matchManagers": ["github-actions"],
      "pinDigests": false
    },
    {
      "description": "A DaisyUI bump moves the submodule tag and regenerates every component — always review. Capped at 5.5.22: DaisyUI 5.5.23 removed the static packages/docs/static/llms.txt that codegen/src/parser/llms-txt.js reads, so anything above breaks :lib:generateComponents. Lift this cap only together with a reworked parser.",
      "matchDepNames": ["org.webjars.npm:daisyui"],
      "automerge": false,
      "allowedVersions": "<=5.5.22"
    }
  ],

  "customManagers": [
    {
      "customType": "regex",
      "description": "daisyui.version in gradle.properties is the single source of truth for the submodule tag, the codegen input and the served webjar. Tracked against the webjar on Maven Central so a version is only ever offered when the CSS artifact actually exists.",
      "managerFilePatterns": ["/(^|/)gradle\\.properties$/"],
      "matchStrings": ["daisyui\\.version=(?<currentValue>.+)"],
      "depNameTemplate": "org.webjars.npm:daisyui",
      "datasourceTemplate": "maven"
    }
  ],

  "gradle": {
    "enabled": true,
    "managerFilePatterns": [
      "/(^|/)build\\.gradle\\.kts$/",
      "/(^|/)settings\\.gradle\\.kts$/",
      "/(^|/)gradle\\.properties$/",
      "/(^|/)buildSrc/.+\\.gradle\\.kts$/"
    ]
  },

  "npm": {
    "enabled": true,
    "managerFilePatterns": [
      "/(^|/)e2e-tests/package\\.json$/"
    ]
  },

  "github-actions": {
    "enabled": true,
    "managerFilePatterns": [
      "/^\\.github/workflows/[^/]+\\.ya?ml$/"
    ]
  }
}
