# Ignore Gradle project-specific cache directory
.gradle
**/.gradle/

# Ignore Gradle build output directory
build

# Ignore Kotlin plugin data
.kotlin

# Ignore npm dependencies (node_modules everywhere, but keep package-lock.json in subprojects)
node_modules/

# Ignore IDE files
.idea/

# Ignore CodeSeeker index
.codeseeker/

# Ignore local scratch directory
tmp/

# NOTE: generated sources are COMMITTED under lib/generated/ and must not be
# ignored. The rules that used to hide them inside lib/src/ are gone with the
# paths they guarded.

**/.classpath
**/.project
**/.settings/
**/bin/

# Ignore AI/tool scratch dirs
.omo/
.junie/
.playwright-mcp/
.air/
