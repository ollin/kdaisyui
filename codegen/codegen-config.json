        "name": "Popover",
        "element": "DIV",
        "cssClass": "modal",
        "staticAttributes": { "popover": "" }
      }
    ],
    "megamenu": [
      {
        "name": "Panel",
        "element": "DIV",
        "cssClass": null,
        "staticAttributes": { "popover": "" }
      }
    ]
  },
